module Qr;

// QR codes (model 2) in byte mode, versions 1 to 40, at any error correction level: the text's
// UTF-8 bytes in the smallest version that holds them, Reed-Solomon blocks interleaved, and the
// mask with the lowest standard penalty, scored with its format info drawn in, the way Nayuki's
// reference encoder (qrcodegen) chooses it: the same code module for module.

// L recovers about 7% of the code, M 15%, Q 25%, H 30%
pub enum Level { L, M, Q, H }

// the modules row by row (true = dark), n*n, without the quiet zone; n is 0 when the text is too
// long for version 40. room is the side of the widest square in the middle that can be left out
// (for a logo) and still be repaired by the error correction, with a quarter of it to spare
pub pod Matrix { int n; bool[] dark; int room; }

pod Grid { int n; bool[] dark; bool[] fixed; }
pod Block { int[] data; int[] ec; }

pub def encode(string text, Level level) : Matrix {
    int len = text.length();
    mut int v = 1;
    while (v <= 40 && 4 + countBits(v) + len * 8 > dataWords(v, level) * 8) v++;
    if (v > 40) return Matrix{n = 0, dark = [], room = 0};

    // mode, count, bytes, terminator, then pad to the capacity
    int capacity = dataWords(v, level);
    mut bool[] bits = [];
    put(&bits, 4, 4);
    put(&bits, len, countBits(v));
    for i in 0:len { put(&bits, text.charAt(i), 8); }
    int left = capacity * 8 - bits.size();
    put(&bits, 0, left < 4 ? left : 4);
    put(&bits, 0, (8 - bits.size() % 8) % 8);
    mut int[] data = [];
    for i in 0:bits.size() / 8 { data.push(byteAt(bits, i)); }
    mut int pad = 0xEC;
    while (data.size() < capacity) {
        data.push(pad);
        pad ^= 0xEC ^ 0x11;
    }

    // split into blocks (the later ones a byte longer), each with its error correction, then
    // interleaved; owner is the block of each codeword
    int count = blockCount(v, level);
    int ec = ecWords(v, level);
    int raw = rawModules(v) / 8;
    int shortLen = raw / count - ec;
    int shortCount = count - raw % count;
    int[] divisor = rsDivisor(ec);
    mut Block[] blocks = [];
    mut int at = 0;
    for i in 0:count {
        int size = shortLen + (i < shortCount ? 0 : 1);
        int[] part = data.slice(at, size);
        at += size;
        blocks.push(Block{data = part, ec = rsRemainder(part, divisor)});
    }
    mut int[] words = [];
    mut int[] owner = [];
    for i in 0:shortLen + 1 {
        for b in 0:count {
            if (i < blocks[b].data.size()) {
                words.push(blocks[b].data[i]);
                owner.push(b);
            }
        }
    }
    for i in 0:ec {
        for b in 0:count {
            words.push(blocks[b].ec[i]);
            owner.push(b);
        }
    }

    mut Grid g = frame(v);
    int[] spot = place(&g, words);
    int format = formatLevel(level);
    mut Grid best = g;
    mut int lowest = -1;
    for m in 0:8 {
        mut Grid t = g;
        applyMask(&t, m);
        drawFormat(&t, format, m);
        int score = penalty(t);
        if (lowest < 0 || score < lowest) {
            best = t;
            lowest = score;
        }
    }
    int budget = (ec - reserved(v, level)) * 3 / 8;
    return Matrix{n = best.n, dark = best.dark, room = room(best.n, spot, owner, count, budget)};
}

// ---- tables ----

def countBits(int v) : int { return v < 10 ? 8 : 16; }

// modules left for codewords once the patterns and format/version info are placed
def rawModules(int v) : int {
    mut int r = (16 * v + 128) * v + 64;
    if (v >= 2) {
        int a = v / 7 + 2;
        r -= (25 * a - 10) * a - 55;
        if (v >= 7) r -= 36;
    }
    return r;
}

def dataWords(int v, Level level) : int { return rawModules(v) / 8 - ecWords(v, level) * blockCount(v, level); }

def ecWords(int v, Level level) : int {
    int[] t = [
        7, 10, 15, 20, 26, 18, 20, 24, 30, 18, 20, 24, 26, 30, 22, 24, 28, 30, 28, 28, 28, 28, 30, 30, 26, 28, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30,
        10, 16, 26, 18, 24, 16, 18, 22, 22, 26, 30, 22, 22, 24, 24, 28, 28, 26, 26, 26, 26, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28,
        13, 22, 18, 26, 18, 24, 18, 22, 20, 24, 28, 26, 24, 20, 30, 24, 28, 28, 26, 30, 28, 30, 30, 30, 30, 28, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30,
        17, 28, 22, 16, 22, 28, 26, 26, 24, 28, 24, 28, 22, 24, 24, 30, 28, 28, 26, 28, 30, 24, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30
    ];
    int l = level;
    return t[l * 40 + v - 1];
}

def blockCount(int v, Level level) : int {
    int[] t = [
        1, 1, 1, 1, 1, 2, 2, 2, 2, 4, 4, 4, 4, 4, 6, 6, 6, 6, 7, 8, 8, 9, 9, 10, 12, 12, 12, 13, 14, 15, 16, 17, 18, 19, 19, 20, 21, 22, 24, 25,
        1, 1, 1, 2, 2, 4, 4, 4, 5, 5, 5, 8, 9, 9, 10, 10, 11, 13, 14, 16, 17, 17, 18, 20, 21, 23, 25, 26, 28, 29, 31, 33, 35, 37, 38, 40, 43, 45, 47, 49,
        1, 1, 2, 2, 4, 4, 6, 6, 8, 8, 8, 10, 12, 16, 12, 17, 16, 18, 21, 20, 23, 23, 25, 27, 29, 34, 34, 35, 38, 40, 43, 45, 48, 51, 53, 56, 59, 62, 65, 68,
        1, 1, 2, 4, 4, 4, 5, 6, 8, 8, 11, 11, 16, 16, 18, 16, 19, 21, 25, 25, 25, 34, 30, 32, 35, 37, 40, 42, 45, 48, 51, 54, 57, 60, 63, 66, 70, 74, 77, 81
    ];
    int l = level;
    return t[l * 40 + v - 1];
}

// small codes keep a few error correction codewords back to catch misreads (ISO 18004 table 9)
def reserved(int v, Level level) : int {
    int l = level;
    if (v == 1) return l == 0 ? 3 : (l == 1 ? 2 : 1);
    if (v == 2 && l == 0) return 2;
    if (v == 3 && l == 0) return 1;
    return 0;
}

// the two bits the format info uses for each level
def formatLevel(Level level) : int {
    int[] t = [1, 0, 3, 2];
    int l = level;
    return t[l];
}

// ---- bits ----

def bit(int value, int i) : bool { return ((value >> i) & 1) != 0; }

def put(mut bool[]& bits, int value, int count) : void {
    mut int i = count - 1;
    while (i >= 0) {
        bits.push(bit(value, i));
        i--;
    }
}

def byteAt(bool[] bits, int i) : int {
    mut int b = 0;
    for j in 0:8 { b = (b << 1) | (bits[i * 8 + j] ? 1 : 0); }
    return b;
}

// ---- Reed-Solomon over GF(256), polynomial 0x11D ----

def gfMul(int x, int y) : int {
    mut int z = 0;
    for i in 0:8 {
        z = (z << 1) ^ ((z >> 7) * 0x11D);
        z ^= ((y >> (7 - i)) & 1) * x;
    }
    return z;
}

// the generator polynomial's coefficients, highest first, without the leading 1
def rsDivisor(int degree) : int[] {
    mut int[] d = [0; degree];
    d[degree - 1] = 1;
    mut int root = 1;
    for i in 0:degree {
        for j in 0:degree {
            d[j] = gfMul(d[j], root);
            if (j + 1 < degree) d[j] ^= d[j + 1];
        }
        root = gfMul(root, 2);
    }
    return d;
}

def rsRemainder(int[] data, int[] divisor) : int[] {
    mut int[] r = [0; divisor.size()];
    for b in data {
        int factor = b ^ r[0];
        r.remove(0);
        r.push(0);
        for j in 0:r.size() { r[j] ^= gfMul(divisor[j], factor); }
    }
    return r;
}

// ---- function patterns ----

def set(mut Grid& g, int x, int y, bool on) : void {
    g.dark[y * g.n + x] = on;
    g.fixed[y * g.n + x] = true;
}

// the distance from a pattern's centre, in rings
def ring(int dx, int dy) : int {
    int a = dx < 0 ? -dx : dx;
    int b = dy < 0 ? -dy : dy;
    return a > b ? a : b;
}

def frame(int v) : Grid {
    int n = v * 4 + 17;
    mut Grid g = Grid{n = n, dark = [false; n * n], fixed = [false; n * n]};
    for i in 0:n {
        set(&g, 6, i, i % 2 == 0);
        set(&g, i, 6, i % 2 == 0);
    }
    finder(&g, 3, 3);
    finder(&g, n - 4, 3);
    finder(&g, 3, n - 4);
    int[] at = alignments(v);
    int last = at.size() - 1;
    for i in 0:at.size() {
        for j in 0:at.size() {
            // not on the three corners the finders hold
            if (!((i == 0 && j == 0) || (i == 0 && j == last) || (i == last && j == 0))) alignment(&g, at[i], at[j]);
        }
    }
    drawFormat(&g, 0, 0);   // reserves the area, each mask writes its own
    if (v >= 7) drawVersion(&g, v);
    return g;
}

// a finder with its light separator, cut off at the edges
def finder(mut Grid& g, int cx, int cy) : void {
    for dy in -4:5 {
        for dx in -4:5 {
            int x = cx + dx;
            int y = cy + dy;
            int d = ring(dx, dy);
            if (x >= 0 && x < g.n && y >= 0 && y < g.n) set(&g, x, y, d != 2 && d != 4);
        }
    }
}

def alignment(mut Grid& g, int cx, int cy) : void {
    for dy in -2:3 {
        for dx in -2:3 { set(&g, cx + dx, cy + dy, ring(dx, dy) != 1); }
    }
}

// the alignment patterns' centres on each axis: 6, then evenly spaced up to n - 7
def alignments(int v) : int[] {
    if (v == 1) return [];
    int count = v / 7 + 2;
    int step = (v * 8 + count * 3 + 5) / (count * 4 - 4) * 2;
    mut int[] at = [6];
    for i in 0:count - 1 { at.push(v * 4 + 10 - (count - 2 - i) * step); }
    return at;
}

def drawFormat(mut Grid& g, int level, int mask) : void {
    int data = (level << 3) | mask;
    mut int rem = data;
    for i in 0:10 { rem = (rem << 1) ^ ((rem >> 9) * 0x537); }
    int bits = ((data << 10) | rem) ^ 0x5412;
    int n = g.n;
    // around the top left finder
    for i in 0:6 { set(&g, 8, i, bit(bits, i)); }
    set(&g, 8, 7, bit(bits, 6));
    set(&g, 8, 8, bit(bits, 7));
    set(&g, 7, 8, bit(bits, 8));
    for i in 9:15 { set(&g, 14 - i, 8, bit(bits, i)); }
    // and split between the other two
    for i in 0:8 { set(&g, n - 1 - i, 8, bit(bits, i)); }
    for i in 8:15 { set(&g, 8, n - 15 + i, bit(bits, i)); }
    set(&g, 8, n - 8, true);
}

def drawVersion(mut Grid& g, int v) : void {
    mut int rem = v;
    for i in 0:12 { rem = (rem << 1) ^ ((rem >> 11) * 0x1F25); }
    int bits = (v << 12) | rem;
    for i in 0:18 {
        int a = g.n - 11 + i % 3;
        int b = i / 3;
        set(&g, a, b, bit(bits, i));
        set(&g, b, a, bit(bits, i));
    }
}

// ---- data ----

// the codewords' bits in two-column zigzags from the bottom right; returns the codeword each
// module holds, -1 for the rest
def place(mut Grid& g, int[] words) : int[] {
    int n = g.n;
    mut int[] spot = [-1; n * n];
    mut int i = 0;
    mut int right = n - 1;
    while (right >= 1) {
        if (right == 6) right = 5;   // the timing column
        bool up = ((right + 1) & 2) == 0;
        for vert in 0:n {
            for j in 0:2 {
                int y = up ? n - 1 - vert : vert;
                int at = y * n + right - j;
                if (!g.fixed[at] && i < words.size() * 8) {
                    g.dark[at] = bit(words[i >> 3], 7 - (i & 7));
                    spot[at] = i >> 3;
                    i++;
                }
            }
        }
        right -= 2;
    }
    return spot;
}

def flips(int m, int x, int y) : bool {
    return match (m) {
        0 => (x + y) % 2 == 0;
        1 => y % 2 == 0;
        2 => x % 3 == 0;
        3 => (x + y) % 3 == 0;
        4 => (x / 3 + y / 2) % 2 == 0;
        5 => x * y % 2 + x * y % 3 == 0;
        6 => (x * y % 2 + x * y % 3) % 2 == 0;
        else => ((x + y) % 2 + x * y % 3) % 2 == 0;
    };
}

def applyMask(mut Grid& g, int m) : void {
    for y in 0:g.n {
        for x in 0:g.n {
            int at = y * g.n + x;
            if (!g.fixed[at] && flips(m, x, y)) g.dark[at] = !g.dark[at];
        }
    }
}

// ---- mask penalty ----

def penalty(Grid g) : int {
    int n = g.n;
    mut int score = 0;
    for i in 0:n { score += line(g.dark, n, i * n, 1) + line(g.dark, n, i, n); }
    for y in 0:n - 1 {
        for x in 0:n - 1 {
            bool c = g.dark[y * n + x];
            if (g.dark[y * n + x + 1] == c && g.dark[(y + 1) * n + x] == c && g.dark[(y + 1) * n + x + 1] == c) score += 3;
        }
    }
    // 10 for every 5% the dark share is away from half
    int total = n * n;
    int off = g.dark.count(d => d) * 20 - total * 10;
    return score + ((off < 0 ? -off : off) + total - 1) / total * 10 - 10;
}

// a row or column: runs of five or more of one colour, and finder-like 1:1:3:1:1 runs with four
// light on a side, the light border around the code counting as light
def line(bool[] dark, int n, int start, int step) : int {
    mut int score = 0;
    mut bool color = false;
    mut int run = 0;
    mut int[] runs = [0; 7];   // the last seven run lengths, newest last
    for k in 0:n {
        bool on = dark[start + k * step];
        if (on == color) {
            run++;
            if (run == 5) score += 3;
            else if (run > 5) score++;
        } else {
            addRun(&runs, run, n);
            if (!color) score += finders(runs) * 40;
            color = on;
            run = 1;
        }
    }
    if (color) {
        addRun(&runs, run, n);
        run = 0;
    }
    addRun(&runs, run + n, n);
    return score + finders(runs) * 40;
}

def addRun(mut int[]& runs, int run, int n) : void {
    int border = runs[6] == 0 ? n : 0;   // the first run starts in the border
    runs.remove(0);
    runs.push(run + border);
}

// called after a light run ends: 0, 1 or 2 finder-like patterns
def finders(int[] r) : int {
    int u = r[5];
    bool core = u > 0 && r[4] == u && r[2] == u && r[1] == u && r[3] == u * 3;
    return (core && r[6] >= u * 4 && r[0] >= u ? 1 : 0) + (core && r[0] >= u * 4 && r[6] >= u ? 1 : 0);
}

// ---- room for a logo ----

// the widest odd square in the middle (clear of the finders and format info) whose codewords
// stay within each block's budget of repairs
def room(int n, int[] spot, int[] owner, int count, int budget) : int {
    mut int k = n - 18;
    while (k > 0 && !repairable(n, k, spot, owner, count, budget)) k -= 2;
    return k < 0 ? 0 : k;
}

def repairable(int n, int k, int[] spot, int[] owner, int count, int budget) : bool {
    mut int[] hit = [0; count];
    mut bool[] seen = [false; owner.size()];
    int from = (n - k) / 2;
    for y in from:from + k {
        for x in from:from + k {
            int w = spot[y * n + x];
            if (w >= 0 && !seen[w]) {
                seen[w] = true;
                hit[owner[w]] += 1;
            }
        }
    }
    return hit.all(h => h <= budget);
}
