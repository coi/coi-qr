module Qr;
import "Draw.coi";

// a version 1 size code with only an L of three modules lit, (8, 0), (9, 0) and (9, 1), plus one
// in the middle at (10, 10)
def ell(int room) : Matrix {
    mut bool[] dark = [false; 441];
    dark[8] = true;
    dark[9] = true;
    dark[30] = true;
    dark[220] = true;
    return Matrix{n = 21, dark = dark, room = room};
}

test "squares: a row's run is one rectangle" {
    Drawing d = draw(ell(0), Look{});
    expect(d.body == "M8 0H10V1H8V0ZM9 1H10V2H9V1ZM10 10H11V11H10V10Z");
    expect(d.hole == 0);
}

test "eyes: ring with a hole cut the other way round, and the pupil" {
    Drawing d = draw(ell(0), Look{});
    expect(d.rings.startsWith("M0 0H7V7H0V0ZM1 1V6H6V1ZM14 0H21V7H14V0Z"));
    expect(d.pupils == "M2 2H5V5H2V2ZM16 2H19V5H16V2ZM2 16H5V19H2V16Z");
    Drawing r = draw(ell(0), Look{ring = Eye::Round, pupil = Eye::Round});
    expect(r.rings.startsWith("M3.5 0A3.5 3.5 0 0 1 7 3.5A3.5 3.5 0 0 1 3.5 7A3.5 3.5 0 0 1 0 3.5A3.5 3.5 0 0 1 3.5 0Z" +
                              "M3.5 1A2.5 2.5 0 0 0 1 3.5A2.5 2.5 0 0 0 3.5 6A2.5 2.5 0 0 0 6 3.5A2.5 2.5 0 0 0 3.5 1Z"));
    expect(r.pupils.startsWith("M3.5 2A1.5 1.5 0 0 1 5 3.5A1.5 1.5 0 0 1 3.5 5A1.5 1.5 0 0 1 2 3.5A1.5 1.5 0 0 1 3.5 2Z"));
    expect(draw(ell(0), Look{ring = Eye::Rounded}).rings.startsWith("M1 0H6A1 1 0 0 1 7 1V6A1 1 0 0 1 6 7H1A1 1 0 0 1 0 6V1A1 1 0 0 1 1 0Z"));
}

test "blobs round only the corners nothing touches" {
    Drawing d = draw(ell(0), Look{dots = Dots::Blob});
    expect(d.body.startsWith("M8.5 0H9.5A0.5 0.5 0 0 1 10 0.5V1H8.5A0.5 0.5 0 0 1 8 0.5A0.5 0.5 0 0 1 8.5 0Z" +
                             "M9 1H10V1.5A0.5 0.5 0 0 1 9.5 2A0.5 0.5 0 0 1 9 1.5V1Z"));
}

test "round dots are circles, one per module" {
    Drawing d = draw(ell(0), Look{dots = Dots::Round});
    expect(d.body.startsWith("M8 0.5a.5 .5 0 1 0 1 0a.5 .5 0 1 0 -1 0ZM9 0.5a.5 .5 0 1 0 1 0a.5 .5 0 1 0 -1 0Z"));
}

test "a logo hole is odd, centred and never wider than the code's room" {
    expect(draw(ell(5), Look{logo = 0.3}).hole == 5);
    expect(draw(ell(5), Look{logo = 0.3}).body == "M8 0H10V1H8V0ZM9 1H10V2H9V1Z");
    expect(draw(ell(3), Look{logo = 0.3}).hole == 3);
    expect(draw(ell(5), Look{logo = 0.1}).hole == 1);
    expect(draw(ell(5), Look{logo = 0.9}).hole == 5);
    expect(draw(ell(0), Look{logo = 0.3}).hole == 0);
}

test "path is the squares look in one string" {
    Matrix c = ell(0);
    Drawing d = draw(c, Look{});
    expect(path(c) == d.body + d.rings + d.pupils);
}

test "room grows with the error correction" {
    string url = "https://example.com/j/KQ7RMX";
    Matrix l = encode(url, Level::L);
    Matrix h = encode(url, Level::H);
    expect(l.room < encode(url, Level::M).room);
    expect(encode(url, Level::Q).room < h.room);
    expect(h.room % 2 == 1 && h.room <= h.n - 18);
}
