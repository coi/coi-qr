module Qr;
import "Qr.coi";

// Expected codes come from Nayuki's qrcodegen (python, encode_segments with make_bytes, no
// error correction boost, automatic mask), module for module.

def rows(Matrix c) : string[] {
    mut string[] out = [];
    for y in 0:c.n {
        mut string row = "";
        for x in 0:c.n { row += c.dark[y * c.n + x] ? "1" : "0"; }
        out.push(row);
    }
    return out;
}

// FNV-1a over the modules as 0 and 1 bytes
def digest(Matrix c) : uint32 {
    mut uint32 h = 2166136261;
    for d in c.dark { h = (h ^ (d ? 1 : 0)) * 16777619; }
    return h;
}

// texts of any length that aren't all one pattern
def sample(int len, int seed) : string {
    string alphabet = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/:.-";
    mut string s = "";
    for i in 0:len { s += alphabet.at((i * 31 + len * 7 + seed) % alphabet.length()); }
    return s;
}

def check(Level level, int len) : string {
    Matrix c = encode(sample(len, 1), level);
    return "${c.n} ${digest(c)}";
}


test "version 1, mask 0" {
    expect(rows(encode("hello", Level::M)) == [
        "111111100110001111111",
        "100000101100001000001",
        "101110100101101011101",
        "101110100011001011101",
        "101110101100101011101",
        "100000100000101000001",
        "111111101010101111111",
        "000000000011100000000",
        "101010100101000010010",
        "001011000010001000011",
        "010100101110100011111",
        "110010000000001000010",
        "011010110010101010000",
        "000000001111010100111",
        "111111100011011100111",
        "100000100011110110000",
        "101110101011011100011",
        "101110100100001100110",
        "101110101110100010101",
        "100000100100001010010",
        "111111101110101100011"
    ]);
}

test "a short link: version 3 with an alignment pattern" {
    expect(rows(encode("https://example.com/j/KQ7RMX", Level::M)) == [
        "11111110001101001110001111111",
        "10000010101100111001101000001",
        "10111010010011101001001011101",
        "10111010010011110110001011101",
