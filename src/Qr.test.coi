test "text goes in as UTF-8" {
    Matrix c = encode("Grüße, 日本 🐟", Level::M);
    expect(c.n == 25 && digest(c) == 1569681913);
}

test "too long is an empty code" {
    Matrix c = encode(sample(2332, 1), Level::M);
    expect(c.n == 0 && c.dark.isEmpty() && c.room == 0);
}
