test "version 7 carries version info, mask 3" {
    expect(rows(encode(sample(110, 3), Level::M)) == [
        "111111101111010010110000010101101100101111111",
        "100000101100001001100011011100101001001000001",
        "101110100101000101011111010000110001001011101",
        "101110101011011110111100010000010001101011101",
