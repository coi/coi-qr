        "100000100111011001111000100111110000001000001",
        "111111101010101010101010101010101010101111111",
        "000000001001000001111000101100100100000000000",
        "101101110111101011111111100111110000001001011",
        "010101001010010000100101110101101101110110101",
        "001011101100110100011101000111011010000110111",
        "110111011010111011010111001010101010111101011",
        "101110101110000101110110101010110010011001110",
        "110111010110110010101110011011001100011101001",
        "110100101100101010010001000100111010000011100",
        "100110011101101111010010101011111011010001110",
        "000110110010111101001000111101001011000100100",
        "100101000011001101100100100001010111000110001",
        "100101110011000101011001111101101111101101100",
        "011111011110101110001100110100000011001011011",
        "110011111100100011001111111110000101111111111",
        "101110001100010000111000111111100000100011011",
        "000010101011111011011010101000110100101010011",
        "100110001010011101011000111000010100100011000",
        "101011111101101010101111100000010011111111100",
        "010001010111010000000000111101011100110101111",
        "110111110010100010111000010111110011000010000",
        "111100000001001100100011100101011111010001101",
        "001101101000110111011101010001101001011001110",
        "001100000101010001111001000011010011000111001",
        "011101111110111010110110101110110110110001100",
        "001100011101001010110000101111110101101010011",
        "110111100010000111100110110011000110110101000",
        "101010001000101010011101010101101001000101111",
        "000010110101101010100001111010111001011110011",
        "011110001010010010111111010101010011111111001",
        "100110110110001011011111110000010100111111010",
        "000000001110100001101000101001010101100011010",
        "111111101111001001111010100011100001101010110",
        "100000101110111001011000111001101100100011111",
        "101110100110110011101111111101111010111111111",
        "101110101000101100111011000011011010101101111",
        "101110101011001111000001101101001011110001010",
        "100000100000001110110101000110001111011010001",
        "111111101100001001010111011010000000100001000"
    ]);
}

// each level at 0, 1 and 5 bytes and at both sides of the capacity of versions 1, 2, 3, 6, 7, 9,
// 10, 15, 27 and 40: the version, the blocks of each size and the mask all have to match
